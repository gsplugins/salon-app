# =====================
# Root .gitignore for salon-app
# =====================

# Backend (Laravel)
/backend/vendor/
/backend/.env
/backend/.env.*
/backend/storage/*.key
/backend/storage/framework/
/backend/storage/logs/
/backend/bootstrap/cache/
/backend/.phpunit.result.cache
/backend/composer.lock
/backend/package-lock.json
/backend/node_modules/

# Frontend (Next.js)
/frontend/node_modules/
/frontend/.next/
/frontend/out/
/frontend/build/
/frontend/dist/
/frontend/.env
/frontend/.env.*.local
/frontend/package-lock.json
/frontend/yarn.lock

# General
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
*.swp
*.swo
*~
desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
.cache/

# Database
*.sql
*.sqlite
*.sqlite3

# Archives
*.zip
*.rar
*.7z
*.tar.gz

# Certificates
*.pem
*.crt
*.key
*.p12