# =====================
# Root .gitignore for salon-app
# =====================

# Old monorepo `backend/` path (ignore if an empty/locked folder remains on disk)
/backend/

# Frontend (Next.js)
/frontend/node_modules/
/frontend/.next/
/frontend/out/
/frontend/build/
/frontend/dist/
/frontend/.env
/frontend/.env.*.local
/frontend/package-lock.json
/frontend/yarn.lock

# Backend (Supabase Node API)
/backend-supabase/node_modules/
/backend-supabase/dist/
/backend-supabase/.env
/backend-supabase/.env.*
/backend-supabase/*vercel*.env
/backend-supabase/*.local.env
/frontend/*vercel*.env
/frontend/*.local.env

# General
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
*.swp
*.swo
*~
desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
.cache/

# Database
*.sql
!/backend-supabase/supabase/*.sql
!/backend-supabase/supabase/migrations/*.sql
*.sqlite
*.sqlite3

# Archives
*.zip
*.rar
*.7z
*.tar.gz

# Certificates
*.pem
*.crt
*.key
*.p12

.agents
skills-lock.json