# Server-side Supabase URL (HTTPS project URL, same host as NEXT_PUBLIC_). Prefer this for service-role usage.
# SUPABASE_URL=https://xxxx.supabase.co

# Canonical public URL of this Next app (used by RSC server fetch + cron). On Vercel: https://your-app.vercel.app
# SITE_URL=

# Optional: set on Vercel and use the same value as the cron job auth secret so only Vercel Cron can call /api/keep-alive
# CRON_SECRET=

# Direct Postgres (Prisma/pg) only — not used by @supabase/supabase-js. Use Supabase pooler on 6543 with pgbouncer=true.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
